<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             x:Class="ColorPicker.MainPage">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="20" BackgroundColor="#0F0F23">

            <!-- Header Section -->
            <StackLayout Grid.Row="0" Margin="0,40,0,30">
                <Label Text="Color Picker" 
                       FontSize="32" 
                       FontAttributes="Bold"
                       TextColor="#FFFFFF" 
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>
                <BoxView HeightRequest="3" 
                         BackgroundColor="#7C3AED" 
                         WidthRequest="80" 
                         HorizontalOptions="Center"
                         CornerRadius="2"/>
            </StackLayout>

            <!-- Main Content -->
            <StackLayout Grid.Row="1" Spacing="25">

                <!-- Hex Input Card -->
                <Frame BackgroundColor="#1A1A2E" 
                       CornerRadius="16" 
                       HasShadow="True"
                       Padding="20"
                       BorderColor="#333366">
                    <StackLayout Spacing="15">
                        <Label Text="Hex Color Input" 
                               TextColor="#E0E0E0" 
                               FontSize="18" 
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Frame Grid.Column="0" 
                                   BackgroundColor="#16213E" 
                                   CornerRadius="12" 
                                   HasShadow="False"
                                   Padding="0"
                                   BorderColor="#3D4A6B">
                                <Entry x:Name="txtInput"
                                       BackgroundColor="Transparent"
                                       TextColor="#FFFFFF"
                                       PlaceholderColor="#8B8B8B"
                                       Placeholder="Enter hex code (e.g., #FF5733)"
                                       FontSize="16"
                                       Margin="15,12"
                                       ClearButtonVisibility="WhileEditing"/>
                            </Frame>

                            <Button Grid.Column="1"
                                    Text="Apply"
                                    Clicked="btnEnterHex"
                                    BackgroundColor="#7C3AED"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Margin="10,0,0,0"
                                    WidthRequest="80"
                                    HeightRequest="48">
                            </Button>
                        </Grid>
                    </StackLayout>
                </Frame>

                <!-- Color Sliders Card -->
                <Frame BackgroundColor="#1A1A2E" 
                       CornerRadius="16" 
                       HasShadow="True"
                       Padding="25"
                       BorderColor="#333366">
                    <StackLayout Spacing="25">
                        <Label Text="RGB Sliders" 
                               TextColor="#E0E0E0" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                        <!-- Red Slider -->
                        <StackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" 
                                       Text="Red" 
                                       TextColor="#FF6B6B" 
                                       FontSize="16" 
                                       FontAttributes="Bold"/>
                                <Label Grid.Column="1" 
                                       x:Name="lblRedValue"
                                       Text="0" 
                                       TextColor="#FF6B6B" 
                                       FontSize="16" 
                                       FontAttributes="Bold"/>
                            </Grid>
                            <Slider x:Name="sldRed"
                                    Minimum="0"
                                    Maximum="255"
                                    MinimumTrackColor="#FF6B6B"
                                    MaximumTrackColor="#3A3A52"
                                    ThumbColor="#FF6B6B"
                                    ValueChanged="sld_ValueChanged"/>
                        </StackLayout>

                        <!-- Green Slider -->
                        <StackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" 
                                       Text="Green" 
                                       TextColor="#51CF66" 
                                       FontSize="16" 
                                       FontAttributes="Bold"/>
                                <Label Grid.Column="1" 
                                       x:Name="lblGreenValue"
                                       Text="0" 
                                       TextColor="#51CF66" 
                                       FontSize="16" 
                                       FontAttributes="Bold"/>
                            </Grid>
                            <Slider x:Name="sldGreen"
                                    Minimum="0"
                                    Maximum="255"
                                    MinimumTrackColor="#51CF66"
                                    MaximumTrackColor="#3A3A52"
                                    ThumbColor="#51CF66"
                                    ValueChanged="sld_ValueChanged"/>
                        </StackLayout>

                        <!-- Blue Slider -->
                        <StackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" 
                                       Text="Blue" 
                                       TextColor="#74C0FC" 
                                       FontSize="16" 
                                       FontAttributes="Bold"/>
                                <Label Grid.Column="1" 
                                       x:Name="lblBlueValue"
                                       Text="0" 
                                       TextColor="#74C0FC" 
                                       FontSize="16" 
                                       FontAttributes="Bold"/>
                            </Grid>
                            <Slider x:Name="sldBlue"
                                    Minimum="0"
                                    Maximum="255"
                                    MinimumTrackColor="#74C0FC"
                                    MaximumTrackColor="#3A3A52"
                                    ThumbColor="#74C0FC"
                                    ValueChanged="sld_ValueChanged"/>
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Color Display Card -->
                <Frame BackgroundColor="#1A1A2E" 
                       CornerRadius="16" 
                       HasShadow="True"
                       Padding="25"
                       BorderColor="#333366">
                    <StackLayout Spacing="20">
                        <Label Text="Color Preview" 
                               TextColor="#E0E0E0" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                        <!-- Color Preview Box -->
                        <Frame x:Name="Container"
                               BackgroundColor="#000000"
                               CornerRadius="12"
                               HeightRequest="80"
                               HasShadow="True"
                               BorderColor="#444466"
                               Margin="0,10">
                            <Frame.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.3"/>
                            </Frame.Shadow>
                        </Frame>

                        <!-- Hex Display -->
                        <Frame BackgroundColor="#16213E" 
                               CornerRadius="10" 
                               HasShadow="False"
                               Padding="15"
                               BorderColor="#3D4A6B">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       x:Name="lblHex"
                                       Text="#000000"
                                       TextColor="#FFFFFF"
                                       FontSize="18"
                                       FontFamily="Courier"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </StackLayout>
                </Frame>

                <!-- Random Color Button -->
                <Button x:Name="btnRandomizer"
                        Text="Generate Random Color"
                        Clicked="Randomizer"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="56"
                        Margin="0,10">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#667EEA" Offset="0.0" />
                            <GradientStop Color="#764BA2" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackLayout>

            <!-- Footer -->
            <StackLayout Grid.Row="2" Margin="0,30,0,20">
                <Label Text="Tap sliders or enter hex codes to explore colors" 
                       TextColor="#8B8B8B" 
                       FontSize="14" 
                       HorizontalOptions="Center"/>
            </StackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
